package org.acme.mqtt;

import org.acme.tracing.messageparams.MqttSendMessage;
import org.eclipse.microprofile.config.inject.ConfigProperty;
import org.eclipse.paho.client.mqttv3.DisconnectedBufferOptions;
import org.eclipse.paho.client.mqttv3.IMqttActionListener;
import org.eclipse.paho.client.mqttv3.IMqttDeliveryToken;
import org.eclipse.paho.client.mqttv3.IMqttToken;
import org.eclipse.paho.client.mqttv3.MqttAsyncClient;
import org.eclipse.paho.client.mqttv3.MqttCallback;
import org.eclipse.paho.client.mqttv3.MqttConnectOptions;
import org.eclipse.paho.client.mqttv3.MqttException;
import org.eclipse.paho.client.mqttv3.MqttMessage;
import org.eclipse.paho.client.mqttv3.persist.MemoryPersistence;
import org.jboss.logging.Logger;

import jakarta.annotation.PostConstruct;
import jakarta.annotation.PreDestroy;
import jakarta.enterprise.context.ApplicationScoped;

/**
 * Publisher optimized for low-latency sends:
 * - Uses MqttAsyncClient (non-blocking)
 * - Automatic reconnect + disconnected buffering
 * - Early connect; no blocking in publish hot path
 * - QoS 0, non-retained
 * - Optional loopback subscription (disable for pure publish benchmarking)
 */
@ApplicationScoped
public class MqttClientService {

    private static final Logger logger = Logger.getLogger(MqttClientService.class);

    // ---- Env-configurable knobs -------------------------------------------------
    @ConfigProperty(name = "POD_NAME")
    String podName;

    @ConfigProperty(name = "SERVICE")
    String service;

    @ConfigProperty(name = "mqtt.publisher.enableLoopbackSub", defaultValue = "true")
    boolean enableLoopbackSub; // set false to remove sub overhead during perf tests

    @ConfigProperty(name = "mqtt.publisher.topic.loopback", defaultValue = "mqtt-message-in/1/2/app/test/pull")
    String loopbackTopic;

    // Buffer publishes while disconnected (async client feature)
    @ConfigProperty(name = "mqtt.publisher.buffer.enabled", defaultValue = "true")
    boolean bufferWhenDisconnected;

    @ConfigProperty(name = "mqtt.publisher.buffer.size", defaultValue = "10000")
    int disconnectedBufferSize;

    // Keep-alive, timeouts (keep conservative but low)
    @ConfigProperty(name = "mqtt.keepAliveSec", defaultValue = "30")
    int keepAliveSec;

    @ConfigProperty(name = "mqtt.connTimeoutSec", defaultValue = "5")
    int connTimeoutSec;

    @ConfigProperty(name = "mqtt.cleanSession", defaultValue = "true")
    boolean cleanSession;

    @ConfigProperty(name = "mqtt.maxInflight", defaultValue = "1000")
    int maxInflight;

    // -----------------------------------------------------------------------------

    private String broker;
    private volatile boolean connecting;
    private MqttAsyncClient client;

    @PostConstruct
    void configureBroker() {
        int index = extractOrdinal(podName);
        logger.info("Resolved index: " + index);
        broker = "tcp://mqtt-server-" + index + service;
        logger.info("Resolved broker address: " + broker);
    }

    /**
     * Connect early and (optionally) subscribe for loopback logs.
     * Call this once (e.g., at startup) with your loopback topic.
     */
    public void init(String topic) {
        connectAndMaybeSubscribe(topic);
    }

    private synchronized void connectAndMaybeSubscribe(String topic) {
        if (client != null && client.isConnected()) {
            return;
        }
        try {
            logger.infof("Connecting (async) to MQTT broker: %s", broker);

            client = new MqttAsyncClient(broker, MqttAsyncClient.generateClientId(), new MemoryPersistence());

            // Thin callback; only loopback log if enabled
            client.setCallback(new MqttCallback() {
                @Override
                public void connectionLost(Throwable cause) {
                    logger.warn("MQTT connection lost: " + (cause == null ? "unknown" : cause.getMessage()));
                }

                @Override
                public void messageArrived(String topic, MqttMessage message) {
                    if (!enableLoopbackSub)
                        return;
                    long receivedAt = System.nanoTime();
                    logger.infof("Message arrived (loopback). Topic: %s Size: %d bytes at %d",
                            topic, message.getPayload() == null ? 0 : message.getPayload().length, receivedAt);
                }

                @Override
                public void deliveryComplete(IMqttDeliveryToken token) {
                    // not used for QoS 0 accounting
                }
            });

            MqttConnectOptions connOpts = new MqttConnectOptions();
            connOpts.setAutomaticReconnect(true);
            connOpts.setCleanSession(cleanSession);
            connOpts.setKeepAliveInterval(keepAliveSec);
            connOpts.setConnectionTimeout(connTimeoutSec);
            connOpts.setMaxInflight(maxInflight);

            connecting = true;
            client.connect(connOpts, /* userContext */ null, new IMqttActionListener() {
                @Override
                public void onSuccess(IMqttToken asyncActionToken) {
                    connecting = false;
                    logger.info("Connected to MQTT broker (async)");

                    // Configure disconnected buffer so publish() doesn't block/throw when link
                    // blips
                    DisconnectedBufferOptions buf = new DisconnectedBufferOptions();
                    buf.setBufferEnabled(bufferWhenDisconnected);
                    buf.setBufferSize(disconnectedBufferSize);
                    buf.setPersistBuffer(false);
                    buf.setDeleteOldestMessages(true);
                    client.setBufferOpts(buf);

                    if (enableLoopbackSub) {
                        try {
                            logger.infof("Subscribing (loopback) to topic: %s", topic);
                            client.subscribe(topic, /* qos */ 0);
                            logger.infof("Successfully subscribed to topic: %s", topic);
                        } catch (MqttException e) {
                            logger.warn("Loopback subscribe failed (non-fatal for publisher)", e);
                        }
                    }
                }

                @Override
                public void onFailure(IMqttToken asyncActionToken, Throwable exception) {
                    connecting = false;
                    logger.error("Failed to connect to MQTT broker", exception);
                }
            });

        } catch (MqttException me) {
            connecting = false;
            logger.error("Error creating/connecting MQTT async client", me);
        }
    }

    /**
     * Publish as fast as possible:
     * - No blocking waits (async client)
     * - QoS 0, non-retained
     * - Buffers if temporarily disconnected (depending on config)
     */
    public void publishMessage(String topic, MqttSendMessage payload) {
        try {
            // Fast-path: if client not ready, attempt to (re)connect in background and bail
            // (or buffer later)
            if (client == null) {
                connectAndMaybeSubscribe(loopbackTopic);
            }

            // Stamp timing directly into the message before serialization
            final long sentEpochMs = System.currentTimeMillis(); // cross-JVM comparable
            final long sentNano = System.nanoTime(); // local reference only
            payload.setSentEpochMs(sentEpochMs);
            payload.setSentNano(sentNano);
            logger.infof("Começo do envio sentEpochMs=%d sentNano=%d", sentEpochMs, sentNano);
            byte[] data = payload.serialize();
            if (data == null) {
                throw new IllegalStateException("Failed to serialize MqttSendMessage");
            }

            // Build message (non-retained, QoS 0)
            MqttMessage message = new MqttMessage(data);
            message.setQos(0);
            message.setRetained(false);

            // Attempt publish (async). If disconnected but buffer is enabled, Paho will
            // queue.
            client.publish(topic, message, /* userContext */ null, new IMqttActionListener() {
                @Override
                public void onSuccess(IMqttToken asyncActionToken) {
                }

                @Override
                public void onFailure(IMqttToken asyncActionToken, Throwable exception) {
                    // If disconnected buffering is enabled, publish might still be queued;
                    // onFailure means it wasn't accepted.
                    logger.warnf("Publish failed (topic=%s). connected=%s bufferEnabled=%s reason=%s",
                            topic, (client != null && client.isConnected()), bufferWhenDisconnected,
                            exception == null ? "unknown" : exception.getMessage());
                }
            });

        } catch (MqttException e) {
            logger.error("Error while publishing message to MQTT broker", e);
        }
    }

    @PreDestroy
    public void cleanup() {
        try {
            if (client != null) {
                if (client.isConnected()) {
                    client.disconnect();
                }
                client.close();
                logger.info("Disconnected from MQTT broker");
            }
        } catch (MqttException e) {
            logger.error("Error while disconnecting MQTT client", e);
        }
    }

    // ---- helpers ----------------------------------------------------------------
    private int extractOrdinal(String name) {
        try {
            return Integer.parseInt(name.replaceAll(".*-(\\d+)$", "$1"));
        } catch (Exception e) {
            logger.warn("Could not extract ordinal from pod name '" + name + "', defaulting to 0");
            return 0;
        }
    }
}
